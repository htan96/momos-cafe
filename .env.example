# Database
DATABASE_URL=

NEXT_PUBLIC_SITE_URL=

# ── Transactional outbound email (Amazon SES v2 — server/runtime only; never NEXT_PUBLIC_* these) ─
# Verified SES identity used as Simple `FromEmailAddress`:
SES_FROM_EMAIL=
# Required for operational inbound threading when it differs from the `SES_FROM_EMAIL` domain (reply+TOKEN@..., support@..., catering@...).
SES_INBOUND_REPLY_DOMAIN=
# SNS topic ARN that publishes SES receive notifications consumed by `/api/email/inbound-ses` (strict allow-list after signature verification).
SES_INBOUND_SNS_TOPIC_ARN=
# Optional overrides for recognizable shared inbox local-parts (`support@domain`, `catering@domain`).
# SES_OPS_SUPPORT_LOCALPART=support
# SES_OPS_CATERING_LOCALPART=catering
# Optional per-sender (From) inbound cap across 24h (see `rateLimitHit` docs); default 400 when unset / invalid.
# SES_OPS_INBOUND_RL_PER_SENDER_DAY=400
# Optional single Reply-To for all SES sends (`SendEmail`: ReplyToAddresses). Overridden when callers pass `replyTo`.
SES_REPLY_TO=
# Optional SESv2 Configuration Set (console-defined).
SES_CONFIGURATION_SET_NAME=

# Region: prefer **AWS_REGION**; **AWS_DEFAULT_REGION** is fallback (see `resolveAwsRegion`).
AWS_REGION=

# Credential chain hints: static keys via env vars, or omit keys on EC2 / ECS / Lambda for IAM/instance roles.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Internal staging smoke: real `EmailThread.id` UUID (see `POST /api/internal/email/ses-smoke-send`).
SES_SMOKE_THREAD_ID=

# ── Resend inbound only (`/api/email/inbound` — Svix signature verification via `verifyResendInbound`) ─
# **`RESEND_API_KEY`** is deprecated for this repo (outbound is SES-only; no code path consumes it).

RESEND_WEBHOOK_SECRET=

# **`RESEND_FROM_EMAIL`** deprecated — leftover from outbound Resend; inbound route does not read it.



# Legacy / unused outbound Resend vars (avoid setting in new environments):
# EMAIL_TRANSPORT=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Internal APIs (orchestration / server jobs — never expose from browser)
INTERNAL_API_SECRET=

# ── AWS Cognito (central IdP — see lib/auth/cognito/README.ts) ──
# Cognito console → User pools → your pool
COGNITO_REGION=
COGNITO_USER_POOL_ID=
# Cognito console → User pools → App integration → App clients (prefer public SPA + PKCE; omit secret when unused)
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Optional IAM user for **Admin** Cognito APIs (ListUsers, AdminGetUser, group membership). Use when runtime has no task/instance role (e.g. Vercel).
# Scope policy to `cognito-idp:ListUsers`, `ListUsersInGroup`, `AdminGetUser`, `AdminListGroupsForUser`, `AdminAddUserToGroup`, `AdminRemoveUserFromGroup` on this pool.
# Falls back to paired `AWS_ACCESS_KEY_ID` / `AWS_SECRET_ACCESS_KEY` when unset.
COGNITO_IDP_ADMIN_ACCESS_KEY_ID=
COGNITO_IDP_ADMIN_SECRET_ACCESS_KEY=
# Cognito console → Federated identities → Identity pools (reserved for STS / future Amplify-like wiring)
COGNITO_IDENTITY_POOL_ID=
# App integration → Domain — value only, e.g. myapp.auth.us-west-2.amazonaws.com (no https://)
COGNITO_HOSTED_UI_DOMAIN=
# App client → Hosted UI: allowed callback / sign-out URLs for OAuth / Hosted UI flows
COGNITO_OAUTH_REDIRECT_URI=
COGNITO_OAUTH_LOGOUT_URI=
# Comma-separated path prefixes enforced in middleware (empty string disables). Default in code: /account,/admin,/super-admin
COGNITO_PROTECTED_PREFIXES=
# When "false", callers should treat MFA challenges as blocking until RespondToAuthChallenge is implemented
COGNITO_MFA_OPTIONAL=true
# Temporary only: after MFA challenges, server disables user's MFA via AdminSetUserMFAPreference and retries login once.

# Requires IAM cognito-idp:AdminSetUserMFAPPreference on the User Pool. Prefer Cognito console MFA "Optional" instead long-term.
COGNITO_TEMP_DISABLE_USER_MFA_BEFORE_LOGIN=false

# Optional: verbose JSON diagnostics for operational identity Cognito directory search (server logs only — never NEXT_PUBLIC_*).
# OPERATIONAL_IDENTITY_SEARCH_DEBUG=true

# Signs HttpOnly `momos_impersonation` (HMAC-SHA256). Required in production (16+ chars).

IMPERSONATION_SECRET=

# ── Bootstrap super-admin recovery (env-gated; separate from Cognito groups when AUTHZ_SOURCE=db) ──
# Platform owner email + password for break-glass sign-in at `/login` (TOTP required unless disabled).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Set to `0` to disable bootstrap auth entirely.
# BOOTSTRAP_ADMIN_TOTP_REQUIRED=0
# TOTP re-enrollment (clears bootstrap_admin_auth TOTP only): docs/bootstrap-totp-reset.md
# HS256 cookie signing for bootstrap session + pending JWT (32+ chars in production).
SESSION_SECRET=
# AES-256-GCM encryption for TOTP secret at rest (falls back to SESSION_SECRET / INTERNAL_API_SECRET).
TOTP_ENCRYPTION_SECRET=
# Optional alias for TOTP encryption.
# APP_ENCRYPTION_KEY=
# Authoritative role source: `db` (default) | `dual` | `cognito`
# AUTHZ_SOURCE=db
# Development only: allows a deterministic insecure dev secret when IMPERSONATION_SECRET is unset — never in production.

IMPERSONATION_ALLOW_UNSAFE_DEV=false

# ── Square (catalog, payments, webhooks) ──
# `production` | `sandbox` — must match the token you generated in the correct Square environment.
SQUARE_ENVIRONMENT=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Merchant webhook signature verification for `POST /api/webhooks/square`
# Set **Signature key** from Developer Dashboard → Webhooks → your subscription (not the application secret).
# `SQUARE_WEBHOOK_NOTIFICATION_URL` must match the subscription **Notification URL** byte-for-byte
# (`https://`/`http://`, hostname, path, trailing slash — copy/paste). Mismatch breaks HMAC (401).
# Square sends `x-square-hmacsha256-signature` (case-insensitive). Implementation: `lib/webhooks/square/verifySquareWebhookSignature.ts`.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://example.com/api/webhooks/square

# ── Shippo (retail shipping quotes, labels, inbound tracking webhooks) ──
# Live token + env guard (see `lib/shipping/shippoClient.ts`).
SHIPPO_API_KEY=
SHIPPO_ENV=production

# **Required for production webhook ingress.** When `NODE_ENV=production` or `VERCEL_ENV=production`,
# `/api/webhooks/shippo` returns **503** if this secret is empty — unsigned traffic cannot be accepted.
# HMAC verification per https://docs.goshippo.com/docs/tracking/webhooksecurity (`shippo-auth-signature`: `t=…,v1=…`).
# Non-production: secret may be unset for local webhook testing — never point prod Shippo URLs at dev without HMAC.
SHIPPO_WEBHOOK_SECRET=

# When `true`, `POST /api/ops/shipping/purchase-label` requires `fulfillment_approved_at` on RETAIL fulfillment groups (`confirm_fulfillment` action).
# Super-admin recovery label route bypasses this gate (documented audit path).
SHIPPO_REQUIRE_FULFILLMENT_APPROVAL=false

# ── Unified commerce checkout (draft `CommerceOrder` + `PaymentRecord` before Square charge) ──
# Set to `0`, `false`, or `off` to allow legacy `POST /api/order` without a prior `POST /api/orders` draft shell.
# When unset, unified correlation is **on** (recommended for the storefront).
# UNIFIED_COMMERCE_CHECKOUT=

# Super-admin `/super-admin/operations/payment-integrity` staleness cutoff (hours, min 1). Default 24.
# Cross-ref: `docs/architecture/operational-semantics.md` · `OPERATIONAL_PAYMENT_INTEGRITY_DEFAULT_STALE_HOURS` in `lib/operations/semantics/constants.ts`.
# PAYMENT_INTEGRITY_STALE_HOURS=24
